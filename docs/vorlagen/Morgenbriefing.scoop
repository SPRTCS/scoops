    {
      "title": "Morgenbriefing",
      "schedule": "30 7 * * 1-5",
      "schedule_text": "Werktags um 7:30",
      "prompt": "Schreib das Morgenbriefing für heute. Nutze die Fähigkeit „Tagesüberblick schreiben“."
    },
    {
      "title": "Wochenrückblick",
      "schedule": "0 16 * * 5",
