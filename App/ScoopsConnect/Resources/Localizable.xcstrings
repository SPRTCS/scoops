    "Der Code ist ungültig oder abgelaufen. Erzeuge in AIS Scoops einen neuen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code is invalid or has expired. Create a new one in AIS Scoops."
