    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit deine Scoops Termine in deinem Kalender lesen und neue eintragen können. Gelöscht wird nur mit deiner Freigabe in AIS Scoops."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So your Scoops can read events in your calendar and add new ones. Events are deleted only with your approval in AIS Scoops."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit deine Scoops Telefonnummern, Mailadressen und Geburtstage aus deinen Kontakten nachschlagen können (nur lesen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So your Scoops can look up phone numbers, email addresses, and birthdays in your contacts (read only)."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scoops Connect spricht im VM-Modus mit dem Computer-Server in der virtuellen Maschine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In VM mode, Scoops Connect talks to the computer server in the virtual machine."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit deine Scoops Erinnerungen lesen, anlegen, ändern und abhaken können. Gelöscht wird nur mit deiner Freigabe in AIS Scoops."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So your Scoops can read, create, edit, and complete reminders. Reminders are deleted only with your approval in AIS Scoops."
          }
        }
      }
    }
  },
  "version" : "1.0"
