    "Der Admin" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The admin"
          }
        }
      }
    },
    "Der Assistent zeigt im Schritt „Mit der App verbinden“ einen Kopplungscode mit acht Zeichen, zum Beispiel ABCD-2345." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
