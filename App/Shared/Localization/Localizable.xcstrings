          "stringUnit" : {
            "state" : "new",
            "value" : "Im Sprechmodus spricht %1$@ live mit der natürlichen OpenAI-Stimme (GPT-Live-1), du kannst jederzeit dazwischenreden. Kostet etwa %2$@ pro Minute. Klappt Live nicht, liest die Gerätestimme vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In voice mode, %@ talks live with the natural OpenAI voice (GPT-Live-1), and you can interrupt at any time. Costs about %@ per minute. If live voice doesn’t work, the device voice reads aloud."
          }
        }
      }
