    "Dateien und Links" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files and Links"
          }
        }
      }
    },
    "Dateien, die deine Scoops speichern, und Ergebnisse ihrer Aufgaben landen dort zusätzlich zur Bibliothek (Unterordner „Dateien“ und „Aufgaben“)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files your Scoops save and the results of their tasks end up there in addition to the library (subfolders “Dateien” and “Aufgaben”)."
          }
        }
      }
    },
    "Daten" : {
      "comment" : "Kategorie in „Apps verbinden“",
