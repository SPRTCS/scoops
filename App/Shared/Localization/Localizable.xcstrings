        }
      }
    },
    "Dauerhaft" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indefinitely"
          }
        }
      }
    },
    "Dauerhaft, bis du es aufhebst" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indefinitely, until you unmute"
          }
        }
      }
    },
    "Dauerhafte Freigaben" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing Approvals"
          }
        }
      }
    },
    "Dein Code wurde angenommen. Sobald sich „%@“ meldet, verbinden wir dich automatisch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your code was accepted. As soon as “%@” checks in, we’ll connect you automatically."
          }
        }
      }
    },
    "Dein Konto kennt nur Name, E-Mail und deine Server. Chats, Erinnerungen und API-Schlüssel bleiben auf deinem eigenen Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account only knows your name, email, and servers. Chats, reminders, and API keys stay on your own Mac."
          }
        }
      }
    },
    "Dein Konto verbindet deine Geräte mit deinen Servern. Inhalte bleiben auf deinem Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account connects your devices to your servers. Content stays on your Mac."
          }
        }
      }
    },
    "Dein Scoop" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Scoop"
          }
        }
      }
    },
    "Dein Scoop ist nicht mehr da" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Scoop Is Gone"
          }
        }
      }
    },
    "Dein Scoop kümmert sich darum." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Scoop is taking care of it."
          }
        }
      }
    },
    "Dein Scoop merkt sich Regeln und Vorlieben von selbst. Frag im Chat: „Was weißt du über mich?“" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Scoop remembers rules and preferences on its own. Ask in the chat: “What do you know about me?”"
          }
        }
      }
    },
    "Dein Scoop schaut nach …" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Scoop is checking…"
          }
        }
      }
    },
    "Dein Server hat noch keine Adresse" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Server Has No Address Yet"
          }
        }
      }
    },
    "Dein Server ist gerade nicht erreichbar. Versuch es gleich noch einmal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server can’t be reached right now. Try again in a moment."
          }
        }
      }
    },
    "Dein Server kennt Home, Wecker und Standort noch nicht. Bitte AIS Scoops Server aktualisieren (ab Version 1.18)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support Home, alarms, and location yet. Update AIS Scoops Server (version 1.18 or later)."
          }
        }
      }
    },
    "Dein Server kennt Vorlagen noch nicht. Aktualisiere AIS Scoops Server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support templates yet. Update AIS Scoops Server."
          }
        }
      }
    },
    "Dein Server kennt das Aufgaben-Board noch nicht. Bitte auf Version 1.22 aktualisieren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support the task board yet. Update it to version 1.22 or later."
          }
        }
      }
    },
    "Dein Server kennt eigene MCP-Server noch nicht. Bitte den Server aktualisieren (ab 1.35)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support custom MCP servers yet. Update the server (1.35 or later)."
          }
        }
      }
    },
    "Dein Server kennt noch keine Aufgaben. Bitte aktualisiere ihn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support tasks yet. Update it to use them."
          }
        }
      }
    },
    "Dein Server kennt noch keine weiteren Rechner. Bitte erst auf Version 1.11 aktualisieren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server doesn’t support additional computers yet. Update it to version 1.11 first."
          }
        }
      }
    },
    "Dein Server meldet sich noch nicht" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Server Hasn’t Checked In Yet"
          }
        }
      }
    },
    "Dein erster Ansprechpartner. Meldet sich von selbst, wenn etwas wichtig ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first point of contact. Reaches out on its own when something matters."
          }
        }
      }
    },
    "Dein ganzes Home, mit deinem echten Home und PATH." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your entire home folder, with your real home and PATH."
          }
        }
      }
    },
    "Deine Anmeldung ist abgelaufen. Bitte melde dich erneut an." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in has expired. Sign in again."
          }
        }
