      }
    },
    "Der Code gilt 10 Minuten und nur einmal. Scoops Connect verbindet sich danach von selbst, auch nach einem Neustart." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
