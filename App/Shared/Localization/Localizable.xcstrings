          }
        }
      }
    },
    "%@ ist da. Routinen sind pausiert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is here. Routines are paused."
          }
        }
      }
    },
    "%@ ist schon das stärkste Modell; %@ arbeitet immer damit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ ist schon das stärkste Modell; %2$@ arbeitet immer damit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already the strongest model; %@ always uses it."
          }
        }
      }
    },
    "%@ ist startklar. Schreib ihm einfach, wann immer du etwas brauchst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is ready to go. Just send a message whenever you need something."
          }
        }
      }
    },
    "%@ liest die Chats, Einstellungen und Kosten der anderen Scoops und schlägt dir Verbesserungen vor (Fähigkeiten, Gedächtnis, Anweisungen, Routine-Modell). Übernommen wird erst, wenn du die Karte freigibst. Gespräche mit Gästen geteilter Scoops bleiben ausgeblendet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reads the other Scoops’ chats, settings, and costs and suggests improvements (skills, memory, instructions, routine model). Nothing changes until you approve the card. Conversations with guests of shared Scoops stay hidden."
          }
        }
      }
    },
    "%@ liest die Chats, Einstellungen und Kosten der anderen Scoops und schlägt dir Verbesserungen vor (Fähigkeiten, Gedächtnis, Anweisungen, Routine-Modell). Übernommen wird erst, wenn du die Karte freigibst. Gespräche mit Gästen geteilter Scoops bleiben ausgeblendet. Solange %@ geteilt ist, ist die Aufsicht pausiert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ liest die Chats, Einstellungen und Kosten der anderen Scoops und schlägt dir Verbesserungen vor (Fähigkeiten, Gedächtnis, Anweisungen, Routine-Modell). Übernommen wird erst, wenn du die Karte freigibst. Gespräche mit Gästen geteilter Scoops bleiben ausgeblendet. Solange %2$@ geteilt ist, ist die Aufsicht pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reads the other Scoops’ chats, settings, and costs and suggests improvements (skills, memory, instructions, routine model). Nothing changes until you approve the card. Conversations with guests of shared Scoops stay hidden. While %@ is shared, oversight is paused."
          }
        }
      }
    },
    "%@ liest im Sprechmodus mit der Gerätestimme vor (ohne OpenAI, auch offline)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In voice mode, %@ reads aloud with the device voice (no OpenAI, works offline)."
          }
        }
      }
    },
    "%@ lädt dich ein" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ invites you"
          }
        }
      }
    },
    "%@ lässt sich hier im Moment nicht verbinden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can’t be connected here right now."
          }
        }
      }
    },
    "%@ läuft auf dem Server von %@ und arbeitet mit den Konten von %@. Freigaben entscheidet %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ läuft auf dem Server von %2$@ und arbeitet mit den Konten von %3$@. Freigaben entscheidet %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs on %@’s server and works with %@’s accounts. %@ decides on approvals."
          }
        }
      }
    },
    "%@ läuft auf dem Server von dem Admin und arbeitet mit den Konten von dem Admin. Freigaben entscheidet der Admin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs on the admin’s server and works with the admin’s accounts. The admin decides on approvals."
          }
        }
      }
    },
    "%@ läuft bei %@, mit deren Konten. Alle im Chat sehen deine Nachrichten. %@ kann deine Rechte jederzeit ändern, du kannst jederzeit austreten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ läuft bei %2$@, mit deren Konten. Alle im Chat sehen deine Nachrichten. %3$@ kann deine Rechte jederzeit ändern, du kannst jederzeit austreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs on %@’s server with their accounts. Everyone in the chat sees your messages. %@ can change your permissions at any time, and you can leave at any time."
          }
        }
      }
    },
    "%@ pro Tag" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per day"
          }
        }
      }
    },
    "%@ reicht für die meisten Aufgaben. Wird es schwierig, gibt %@ selbst an %@ ab." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reicht für die meisten Aufgaben. Wird es schwierig, gibt %2$@ selbst an %3$@ ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ handles most tasks. When things get difficult, %@ hands off to %@ on its own."
          }
        }
      }
    },
    "%@ reicht für die meisten Aufgaben. Wird es schwierig, gibt %@ selbst an das stärkere Modell ab." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ reicht für die meisten Aufgaben. Wird es schwierig, gibt %2$@ selbst an das stärkere Modell ab."
          }
